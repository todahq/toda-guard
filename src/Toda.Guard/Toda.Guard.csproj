<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>toda-guard: accounts, groups with nesting, user directories, sign-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="$(OpenIddictVersion)" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="$(OpenIddictVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toda.Guard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toda.Guard.Contracts\Toda.Guard.Contracts.csproj" />
    <ProjectReference Include="..\Toda.Guard.Acting\Toda.Guard.Acting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CASL .NET, the open-source authorization library. -->
    <PackageReference Include="Casl.Net" Version="0.1.0" />
    <!-- ABP's MVC and Postgres modules, and its outbox (ADR 0087: not the platform's module). -->
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="$(AbpVersion)" />
    <!-- EF Core as the design-time tools build against (10.0.12), so a project referencing Guard compiles against the same. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- What an email address looks like (sign-up, added addresses): MimeKit's parser, as before. -->
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <!-- MimeKit pulls Pkcs 10.0.0, under GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (fixed in 10.0.13): pinned to a fixed one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- The authenticator app's QR code (ADR 0082). MIT. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
