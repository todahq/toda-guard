<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>toda-guard: accounts, groups with nesting, user directories, sign-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Toda.Guard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Toda.Platform\Toda.Platform.csproj" />
    <ProjectReference Include="..\Toda.Guard.Contracts\Toda.Guard.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CASL .NET, the open-source authorization library (github.com/tekthar/casl-net). -->
    <PackageReference Include="Casl.Net" Version="0.1.0" />
  </ItemGroup>

</Project>
