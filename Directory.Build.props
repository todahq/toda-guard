<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- One version for every package (see README.md, "Releasing", and CHANGELOG.md); a VersionSuffix makes a prerelease. -->
    <VersionPrefix>0.2.0</VersionPrefix>

    <Authors>AbpGuard contributors</Authors>
    <Company>Tekthar</Company>
    <Copyright>Copyright 2026 AbpGuard contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tekthar/abp-guard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tekthar/abp-guard.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>identity;authentication;authorization;abp;openiddict;casl;two-factor;postgresql</PackageTags>
    <PackageReleaseNotes>https://github.com/tekthar/abp-guard/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <!-- Debugging into the packages: SourceLink (built into the .NET SDK) and a symbol package next to each .nupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AbpVersion>10.6.1</AbpVersion>
    <!-- One version for every OpenIddict package: its server, validation and stores are released together. -->
    <OpenIddictVersion>7.7.1</OpenIddictVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
